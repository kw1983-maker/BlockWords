rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{name} {
      // Signed-in pupils read/write their own save; any signed-in user can
      // read all saves for teacher CSV export on a shared classroom account.
      allow read: if request.auth != null
        && name.matches('^[a-z0-9_]{1,32}$');
      allow create, update: if request.auth != null
        && name.matches('^[a-z0-9_]{1,32}$')
        && request.resource.data.schemaVersion == 1
        && request.resource.data.data is map
        && request.resource.data.uid == request.auth.uid
        && request.resource.size() < 900000;
      allow delete: if false;
    }
  }
}
